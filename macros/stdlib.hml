# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
macro add_ai_strategy(_type_, _country_, _weight_):
  add_ai_strategy:
    type(_type_)
    id(_country_)
    value(_weight_)

# -----------------------------------------------------------------------------
# Dynamic modifiers
# -----------------------------------------------------------------------------
macro add_dynamic_modifier(_modifier_, _scope_=null, _days_=null):
  add_dynamic_modifier:
    modifier(_modifier_)
    if defined(_scope_):
      scope(_scope_)
    if defined(_days_):
      days(_days_)
macro remove_dynamic_modifier(_modifier_):
  remove_dynamic_modifier:
    modifier(_modifier_)
macro has_dynamic_modifier(_modifier_, _country_=null):
  has_dynamic_modifier:
    modifier(_modifier_)
    if defined(_country_):
      scope(_country_)

