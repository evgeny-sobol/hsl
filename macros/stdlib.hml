macro add_opinion_modifier(_country_, _modifier_):
  raw add_opinion_modifier: { target=_country_ modifier=_modifier_ }

macro can_build_railway(_state_A_, _state_B_):
  raw can_build_railway: { start_state=_state_A_ target_state=_state_B_ }

macro compare(_field_, _op_, _val_):
  raw _field_ _op_ _val_

macro remove_opinion_modifier(_country_, _modifier_):
  raw remove_opinion_modifier: { target=_country_ modifier=_modifier_ }

macro set_political_party(_ideology_, _popularity_):
  raw set_political_party: { ideology=_ideology_ popularity=_popularity_ }
