macro add_opinion_modifier(_country_, _modifier_):
  add_opinion_modifier:
    target(_country_)
    modifier(_modifier_)
macro add_relation_modifier(_country_, _modifier_):
  add_relation_modifier:
    target(_country_)
    modifier(_modifier_)
macro remove_opinion_modifier(_country_, _modifier_):
  remove_opinion_modifier:
    target(_country_)
    modifier(_modifier_)
macro remove_relation_modifier(_country_, _modifier_):
  remove_relation_modifier:
    target(_country_)
    modifier(_modifier_)
macro has_opinion(_country_, _amount_, _op_=">"):
  has_opinion:
    target(_country_)
    raw value _op_ _amount_
macro has_opinion_modifier(_country_, _modifier_):
  has_opinion_modifier:
    target(_country_)
    modifier(_modifier_)
macro has_relation_modifier(_country_, _modifier_):
