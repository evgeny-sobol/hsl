# -----------------------------------------------------------------------------
# Politics / popularity
# -----------------------------------------------------------------------------
macro add_popularity(_ideology_or_tag_, _amount_):
  add_popularity:
    ideology(_ideology_or_tag_)
    popularity(_amount_) # Values used are 0.0 to 1.0
macro set_political_party(_ideology_, _popularity_):
  set_political_party:
    ideology(_ideology_)
    popularity(_popularity_) # Values used are 0 to 100
macro compare_ideology_with_faction(_leader_, _amount_, _op_=">"):
  compare_ideology_with_faction:
    leader(_leader_)
    raw value _op_ _amount_

# -----------------------------------------------------------------------------
# Arrays (Clausewitz form; HSL arrays[] are preferred)
# -----------------------------------------------------------------------------
macro add_to_array(_array_, _value_, _index_=null):
  add_to_array:
    array(_array_)
    value(_value_)
    if defined(_index_):
      index(_index_)
macro remove_from_array(_array_, _value_=null, _index_=null):
  remove_from_array:
    array(_array_)
    if defined(_value_):
      value(_value_)
    if defined(_index_):
      index(_index_)
macro resize_array(_array_, _size_, _value_=null):
  resize_array:
    array(_array_)
    size(_size_)
    if defined(_value_):
      value(_value_)

# -----------------------------------------------------------------------------
# Comparisons / infix triggers
# -----------------------------------------------------------------------------
# Engine infix (`has_stability > 0.5`, `date > 1939.1.1`). HSL `a < b`
# always emits check_variable, which is wrong for these triggers.
# Default `_op_` is `>` ("at least"). Clausewitz infix on these triggers
# only accepts `>` / `<` / `=`, not `>=`. Invert with `not $macro(n)` for "below".
macro compare(_field_, _op_, _val_):
  raw _field_ _op_ _val_
macro has_stability(_val_, _op_=">"):
  raw has_stability _op_ _val_
macro date(_date_, _op_=">"):
  raw date _op_ _date_

macro focus_progress(_focus_, _progress_, _op_=">"):
  focus_progress:
    focus(_focus_)
    raw progress _op_ _progress_

macro has_built(_building_, _amount_, _op_=">"):
  has_built:
    type(_building_)
    raw value _op_ _amount_

macro can_build_railway(_state_A_, _state_B_):
  can_build_railway:
    start_state(_state_A_)
    target_state(_state_B_)

# -----------------------------------------------------------------------------
# Flags
# -----------------------------------------------------------------------------
macro has_country_flag(_flag_, _value_=null, _date_=null, _days_=null):
  has_country_flag:
    flag(_flag_)
    if defined(_value_):
      raw value > _value_
    if defined(_date_):
      raw date > _date_
    if defined(_days_):
      raw days > _days_
macro has_global_flag(_flag_, _value_=null, _date_=null, _days_=null):
  has_global_flag:
    flag(_flag_)
    if defined(_value_):
      raw value > _value_
    if defined(_date_):
      raw date > _date_
    if defined(_days_):
      raw days > _days_
macro has_state_flag(_flag_, _value_=null, _date_=null, _days_=null):
  has_state_flag:
    flag(_flag_)
    if defined(_value_):
      raw value > _value_
    if defined(_date_):
      raw date > _date_
    if defined(_days_):
      raw days > _days_
macro has_character_flag(_flag_, _value_=null, _date_=null, _days_=null):
  has_character_flag:
    flag(_flag_)
    if defined(_value_):
      raw value > _value_
    if defined(_date_):
      raw date > _date_
    if defined(_days_):
      raw days > _days_

# Days-only form: the 4-arg has_*_flag cannot skip value/date to pass days.
macro has_country_flag_days(_flag_, _days_):
  has_country_flag:
    flag(_flag_)
    raw days > _days_
macro has_global_flag_days(_flag_, _days_):
  has_global_flag:
    flag(_flag_)
    raw days > _days_
macro has_state_flag_days(_flag_, _days_):
  has_state_flag:
    flag(_flag_)
    raw days > _days_
macro has_character_flag_days(_flag_, _days_):
  has_character_flag:
    flag(_flag_)
    raw days > _days_

macro set_character_flag(_flag_, _value_, _days_=null):
  set_character_flag:
    flag(_flag_)
    value(_value_)
    if defined(_days_):
      days(_days_)
macro set_country_flag(_flag_, _value_, _days_=null):
  set_country_flag:
    flag(_flag_)
    value(_value_)
    if defined(_days_):
      days(_days_)
macro set_global_flag(_flag_, _value_, _days_=null):
  set_global_flag:
    flag(_flag_)
    value(_value_)
    if defined(_days_):
      days(_days_)
macro set_state_flag(_flag_, _value_, _days_=null):
  set_state_flag:
    flag(_flag_)
    value(_value_)
    if defined(_days_):
      days(_days_)
macro modify_character_flag(_flag_, _value_=0, _days_=null):
  modify_character_flag:
    flag(_flag_)
    value(_value_)
    if defined(_days_):
      days(_days_)
macro modify_country_flag(_flag_, _value_=0, _days_=null):
  modify_country_flag:
    flag(_flag_)
    value(_value_)
    if defined(_days_):
      days(_days_)
macro modify_global_flag(_flag_, _value_=0, _days_=null):
  modify_global_flag:
    flag(_flag_)
    value(_value_)
    if defined(_days_):
      days(_days_)
macro modify_state_flag(_flag_, _value_=0, _days_=null):
  modify_state_flag:
    flag(_flag_)
    value(_value_)
    if defined(_days_):
      days(_days_)
macro clear_character_flag(_flag_):
  clr_character_flag(_flag_)
macro clear_country_flag(_flag_):
  clr_country_flag(_flag_)
macro clear_global_flag(_flag_):
  clr_global_flag(_flag_)
macro clear_state_flag(_flag_):
  clr_state_flag(_flag_)

# -----------------------------------------------------------------------------
# Variables (Clausewitz form with optional tooltip; HSL assignment is preferred)
# -----------------------------------------------------------------------------
macro set_variable(_var_, _value_, _tooltip_=null):
  set_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)
macro add_to_variable(_var_, _value_, _tooltip_=null):
  add_to_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)
macro subtract_from_variable(_var_, _value_, _tooltip_=null):
  subtract_from_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)
macro multiply_variable(_var_, _value_, _tooltip_=null):
  multiply_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)
macro divide_variable(_var_, _value_, _tooltip_=null):
  divide_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)
macro modulo_variable(_var_, _value_, _tooltip_=null):
  modulo_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)

# -----------------------------------------------------------------------------
# Value aliases
# -----------------------------------------------------------------------------
macro drift_defence():
  modifier@drift_defence_factor
macro war_support():
  has_war_support

# -----------------------------------------------------------------------------
# Events
# -----------------------------------------------------------------------------
# Immediate: $country_event(siam.8). Delayed in days: $country_event(siam.8, 7).
# hours / random_* stay as an HSL country_event: block.
macro country_event(_id_, _days_=null):
  country_event:
    id(_id_)
    if defined(_days_):
      days(_days_)
macro news_event(_id_, _days_=null):
  news_event:
    id(_id_)
    if defined(_days_):
      days(_days_)

