macro set_political_party(_ideology_, _popularity_):
  set_political_party:
    ideology(_ideology_)
    popularity(_popularity_) # Values used are 0 to 100

macro set_variable(_var_, _value_, _tooltip_=null):
  set_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)
macro add_to_variable(_var_, _value_, _tooltip_=null):
  add_to_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)
macro subtract_from_variable(_var_, _value_, _tooltip_=null):
  subtract_from_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)
macro multiply_variable(_var_, _value_, _tooltip_=null):
  multiply_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)
macro divide_variable(_var_, _value_, _tooltip_=null):
  divide_variable:
    var(_var_)
    value(_value_)
    if defined(_tooltip_):
      tooltip(_tooltip_)
macro modulo_variable(_var_, _value_, _tooltip_=null):
