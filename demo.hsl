# =============================================================================
# HSL — HoI4 Scripting Language: feature showcase
# Compiles to Paradox Clausewitz script. Every construct below is live.
# =============================================================================


# -----------------------------------------------------------------------------
# Variables & assignment
# -----------------------------------------------------------------------------
# `=` writes a persistent variable; a leading underscore marks a temp variable.
current_year = 2026
current_year++
current_year--

_century = 50
_century *= 4
_century /= 2

current_year += _century
current_year -= 100

# `null` clears a persistent variable from memory.
scratch = 7
scratch = null


# -----------------------------------------------------------------------------
# Arithmetic expressions (operator precedence, parentheses, math builtins)
# -----------------------------------------------------------------------------
# Full C-like precedence: ** > * / % > + -. Parentheses override it. The whole
# tree compiles to one nested accumulator value-block — no temp scaffolding.
_a = 1 + 2 * 3
_b = (1 + 2) * 3
_c = 2 ** 3 ** 2
_d = 17 % 5

# Builtins: sqrt(x), round(x), clamp(x, lo, hi). abs via sqrt(x**2).
_hyp   = sqrt(_a ** 2 + _b ** 2)
_score = clamp(round(_c / 10), 0, 50)


# -----------------------------------------------------------------------------
# Conditionals: if / elif / else
# -----------------------------------------------------------------------------
if current_year > 2025:
  log("current_year ([?current_year]) is after 2025")
elif current_year < 2025:
  log("current_year ([?current_year]) is before 2025")
else:
  log("current_year ([?current_year]) is exactly 2025")

# `== null` tests variable existence.
current_year = null
if current_year == null:
  log("current_year was cleared")

# Boolean operators: and / or / not, with parentheses.
if (current_year >= 1939 and current_year < 1945) or current_year == 1945:
  log("WWII is ongoing")
if not is_historical_focus_on():
  log("Ahistorical mode")


# -----------------------------------------------------------------------------
# match / case  (compiles to if / else_if / else)
# -----------------------------------------------------------------------------
# Multiple patterns per arm via `|`; `case _` is the default.
match rival_ideology:
  case conservatism | liberalism | socialism:
    _pop = party_popularity@democratic
  case fascism | nazism:
    _pop = party_popularity@fascism
  case neutrality:
    _pop = party_popularity@neutrality
  case _:
    _pop = 0


# -----------------------------------------------------------------------------
# Loops: numeric range, while, scope iteration, indexed array iteration
# -----------------------------------------------------------------------------
# range(end) / range(start, end) / range(start, end, step) — end exclusive.
for _i in range(5):
  log("tick [?_i]")

for _j in range(2, 30, 3):
  log("step [?_j]")

# while runs its body until the condition (a limit trigger) fails.
while enemies[].size() < 4:
  enemies[].add(0)


# -----------------------------------------------------------------------------
# Arrays
# -----------------------------------------------------------------------------
enemies[].add($GER)
enemies[].add($ITA)
enemies[].remove($ITA)
enemies[].clear()

enemies[].add($SOV)
enemies[].add($JAP)
enemies_count = enemies[].size()
enemies[0] = $USA
_first = enemies[0]

# Membership works as a statement and inside conditions.
if $USA in enemies[] and enemies_count > 0:
  log("USA is on the enemy list")
if $ENG not in enemies[]:
  log("England is not an enemy")

# find lowest / highest: value + index written into temp vars.
threat[].add(10)
threat[].add(4)
threat[].add(25)
threat[].min(_weakest, _weakest_idx)
threat[].max(_strongest, _strongest_idx)


# -----------------------------------------------------------------------------
# Standard triggers & effects, scoped calls, engine references
# -----------------------------------------------------------------------------
if is_major() and has_ideology_group(democracy):
  log("Major democracy")

# `scope::trigger(arg)` and prefixed engine refs (var: / token: / mtth:).
if THIS::has_war_with(FROM):
  log("At war with FROM")

_weight = mtth:base_weight
_saved  = var:cached_value


# -----------------------------------------------------------------------------
# Macros  (compile-time expansion; defaults supported)
# -----------------------------------------------------------------------------
macro grant_boost(amount):
  add_stability(amount)
  add_war_support(amount)

$grant_boost(0.05)


# -----------------------------------------------------------------------------
# LINQ-style iteration with filtering
# -----------------------------------------------------------------------------
# for x in scope(): iterate a country scope; .which(cond) filters it.
for cty in every_country():
  for rnd in random_other_country().which(is_major() and not has_government(cty)):
    cty.rivals[].add(rnd)

# Indexed array iteration: `for value, index in arr[]:` (use _ to drop index).
for foe, idx in enemies[]:
  log("enemy [?idx]: [?foe]")


# -----------------------------------------------------------------------------
# Nested blocks & raw escape hatch
# -----------------------------------------------------------------------------
# `name:` opens a nested block; used for effect/trigger scopes.
ai_will_do:
  base(100)
  modifier:
    _f = clamp(1 - opinion@FROM / 100, 0, 2)
    factor(_f)

# `raw` passes verbatim Clausewitz through untouched, for anything HSL
# doesn't model natively.
raw has_opinion: {
  target = GER
  value = 50
}
