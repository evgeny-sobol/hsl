# =============================================================================
# HSL — HoI4 Scripting Language: feature showcase
# Compiles to Paradox Clausewitz script. Every construct below is live.
# =============================================================================


# -----------------------------------------------------------------------------
# Variables & assignment
# -----------------------------------------------------------------------------
# Bare names are TEMP by default; a leading `&` marks a persistent variable.
&current_year = 2026
&current_year++
&current_year--

century = 50
century *= 4
century /= 2

&current_year += century
&current_year -= 100

# `null` clears a persistent variable from memory.
&scratch = 7
&scratch = null

# Tuple assignment: one statement per pair, each by its own `&` marker.
&budget, rand_min, rand_max = 100, 26, 30


# -----------------------------------------------------------------------------
# Arithmetic expressions (operator precedence, parentheses, math builtins)
# -----------------------------------------------------------------------------
# Full C-like precedence: ** > * / % > + -. Parentheses override it. The whole
# tree compiles to one nested accumulator value-block — no temp scaffolding.
a = 1 + 2 * 3
b = (1 + 2) * 3
c = 2 ** 3 ** 2
d = 17 % 5

# Builtins: sqrt(x), round(x), clamp(x, lo, hi), abs(x).
hyp = sqrt(a ** 2 + b ** 2)
score = clamp(round(c / 10), 0, 50)
dist = abs(a - b)

# Line continuations: a trailing operator (or an explicit `\`) joins the next
# physical line into one logical expression. Indentation on the continuation
# line is ignored — useful for long formulas.
f = 1.5 * (mtth:democracy_factor + mtth:fascism_factor) /
    (2 * mtth:democracy_factor + mtth:communism_factor + mtth:fascism_factor) * 2
g = 10 + 20 + \
    30 + 40

# Random builtins. randi/randf write into a variable; the max bound is
# inclusive. rand(v) uses the engine's default range. `var = randi(lo, hi)` is
# sugar for randi(var, lo, hi).
randi(luck, 1, 6)
&seed = randi(0, 100)
spread = randf(0.0, 1.0)
rand(chaos)


# -----------------------------------------------------------------------------
# Conditionals: if / elif / else
# -----------------------------------------------------------------------------
if current_year > 2025:
  log("current_year ([?current_year]) is after 2025")
elif current_year < 2025:
  log("current_year ([?current_year]) is before 2025")
else:
  log("current_year ([?current_year]) is exactly 2025")

# `== null` tests variable existence.
&current_year = null
if current_year == null:
  log("current_year was cleared")

# Boolean operators: and / or / not, with parentheses.
# Comparisons >= / <= / != emit the long check_variable form (the infix
# engine form only supports =, >, <).
if (current_year >= 1939 and current_year < 1945) or current_year == 1945:
  log("WWII is ongoing")
if not is_historical_focus_on():
  log("Ahistorical mode")
if enemies_count != 0:
  log("Has enemies")

# -----------------------------------------------------------------------------
# match / case (compiles to if / else_if / else)
# -----------------------------------------------------------------------------
# Multiple patterns per arm via `|`; `case _` is the default.
match rival_ideology:
  case conservatism | liberalism | socialism:
    pop = party_popularity@democratic
  case fascism | nazism:
    pop = party_popularity@fascism
  case neutrality:
    pop = party_popularity@neutrality
  case _:
    pop = 0


# -----------------------------------------------------------------------------
# Loops: numeric range, while, scope iteration, indexed array iteration
# -----------------------------------------------------------------------------
# range(end) / range(start, end) / range(start, end, step) — end exclusive.
for i in range(5):
  log("tick [?i]")

for j in range(2, 30, 3):
  log("step [?j]")

# while runs its body until the condition (a limit trigger) fails.
while enemies[].size() < 4:
  enemies[].add(0)


# -----------------------------------------------------------------------------
# Arrays
# -----------------------------------------------------------------------------
enemies[].add(GER)
enemies[].add(ITA)
enemies[].erase(ITA)
enemies[].clear()

enemies[].add(SOV)
enemies[].add(JAP)
enemies_count = enemies[].size()
enemies[0] = USA
first = enemies[0]

# Removal: erase(v) by value, remove_at(i) by index, pop() drops the last.
enemies[].add(ENG)
enemies[].remove_at(0)
enemies[].pop()

# Random access: rand() picks a random element, rand_idx() a random index.
pick = enemies[].rand()
pick_idx = enemies[].rand_idx()

# resize(n) pads with 0 (or truncates); resize(n, v) pads with a given value.
reserves[].resize(3)
reserves[].resize(5, -1)

# Membership works as a statement and inside conditions.
if USA in enemies[] and enemies_count > 0:
  log("USA is on the enemy list")
if ENG not in enemies[]:
  log("England is not an enemy")

# find lowest / highest: value + index written into temp vars.
threat[].add(10)
threat[].add(4)
threat[].add(25)
threat[].min(weakest, weakest_idx)
threat[].max(strongest, strongest_idx)


# -----------------------------------------------------------------------------
# Standard triggers & effects, scoped calls, engine references
# -----------------------------------------------------------------------------
if is_major() and has_ideology_group(democracy):
  log("Major democracy")

# `scope->trigger(arg)` and prefixed engine refs (var: / token: / mtth:).
if THIS->has_war_with(FROM):
  log("At war with FROM")

# A country tag can lead a scope transition the same way.
if $GER->has_war_with(ROOT):
  log("Germany is at war with us")

# Multi-level chains nest each scope: A->B->C(x) => A = { B = { C = x } }.
PREV->any_controlled_state->is_on_continent(south_america)

# `scope->name:` opens a nested block inside that scope transition.
FROM->every_owned_state:
  add_extra_state_shared_building_slots(1)

# "any of" / "all of" sugar: `|` expands to OR, `&` to AND, repeating the
# trigger for each value.
if has_country_leader_ideology(despotism | oligarchism):
  log("Despotic or oligarchic leader")
if has_idea(idea_a & idea_b):
  log("Has both ideas")

# Scorer effects. A temp target (default) selects the _temp engine variant; a
# persistent (`&`) target the plain one. For sorted, the output array and the
# optional scores array must share a lifetime.
get_highest_scored_country(democratic_scorer, largest_democracy)
get_sorted_scored_countries(democratic_scorer, &democracies[], &democracy_scores[])

weight = mtth:base_weight
saved = var:cached_value

# -----------------------------------------------------------------------------
# Macros (compile-time expansion; defaults and optional params supported)
# -----------------------------------------------------------------------------
# Define BEFORE any call — the transformer registers macros top-to-bottom.
macro grant_boost(_amount_):
  add_stability(_amount_)
  add_war_support(_amount_)

$grant_boost(0.05)

# `scope->$macro(args)` expands the macro body inside that scope transition.
FROM->$grant_boost(0.02)
$FRA->$grant_boost(0.01)

# Optional params via `if defined(_p_):` — resolved at expansion time against
# what the CALLER actually passed (defaults don't count). Kept and spliced
# inline if every named param was supplied, dropped entirely otherwise.
# `{param}` interpolates inside an identifier (word-boundary sub can't).
macro tag_idea(_tag_, _days_=null):
  add_timed_idea:
    idea(idea_{_tag_}_boost)
    if defined(_days_):
      days(_days_)

$tag_idea(ENG)          # no days line
$tag_idea(ENG, 90)      # days = 90

# -----------------------------------------------------------------------------
# LINQ-style iteration with filtering
# -----------------------------------------------------------------------------
# for x in scope(): iterate a country scope; .which(cond) filters it.
for cty in every_country():
  for rnd in random_other_country().which(is_major() and not has_government(cty)):
    cty.&rivals[].add(rnd)

# Indexed array iteration: `for value, index in arr[]:` (use _ to drop index).
for foe, idx in enemies[]:
  log("enemy [?idx]: [?foe]")

# `break` leaves the loop: the compiler declares a unique flag in the loop
# header and sets it here. Works inside nested ifs; nested loops get separate
# flags.
for foe, idx in enemies[]:
  if foe == USA:
    found_at = idx
    break


# -----------------------------------------------------------------------------
# Nested blocks & raw escape hatch
# -----------------------------------------------------------------------------
# `name:` opens a nested block; used for effect/trigger scopes.
ai_will_do:
  base(100)
  modifier:
    f = clamp(1 - opinion@FROM / 100, 0, 2)
    factor(f)

# `raw` passes verbatim Clausewitz through untouched, for anything HSL
# doesn't model natively.
raw has_opinion: {
  target = GER
  value = 50
}
