# =============================================================================
# ENTRY POINT
# =============================================================================

start: (_NL | item)*

?item: if_statement
     | elif_statement
     | else_statement
     | linq_statement
     | array_loop
     | macro_def
     | raw_block
     | expr_statement    _NL
     | func_call        _NL
     | scoped_func_call _NL
     | assignment       _NL
     | short_assign     _NL
     | math_assign      _NL
     | inc_dec          _NL
     | array_method     _NL
     | array_minmax     _NL
     | array_assign     _NL
     | var_check        _NL
     | not_statement    _NL
     | pass_statement   _NL
     | clear_var        _NL
     | clear_arr        _NL
     | null_check       _NL
     | array_null_check _NL
     | comment          _NL
     | generic_block

# =============================================================================
# CONTROL FLOW
# =============================================================================

if_statement:   "if"   ( "(" condition ")" | condition ) block
elif_statement: "elif" ( "(" condition ")" | condition ) block
else_statement: "else" block

# =============================================================================
# CONDITIONS
# =============================================================================

condition:     conj_element (OR_OP conj_element)*
?conj_element: not_element (AND_OP not_element)*
?not_element:  NOT_OP cond_atom -> logical_not
            |  cond_atom
?cond_atom:    func_call
          |    scoped_func_call
          |    var_check
          |    null_check
          |    array_check
          |    array_not_check
          |    array_null_check
          |    assignment
          |    value
          |    "(" condition ")"

# Statement-level negation: `not <trigger>` as a standalone line (e.g. inside
# a macro body). Reuses cond_atom + the logical_not handler, so it expands to
# the same NOT = { ... } block that `NOT::trigger()` produced.
not_statement: NOT_OP cond_atom -> logical_not

# Python-style no-op. Produces nothing; it exists so an indentation block
# can be syntactically non-empty (e.g. an if-branch that does nothing).
pass_statement: "pass"

# A bare value on its own line. Its main purpose is the body of a
# value-macro (`macro f(): some_value`); an operator-macro call used as a
# statement also lands here and passes its statement list straight through.
expr_statement: value

# =============================================================================
# FUNCTIONS & CALLS
# =============================================================================

func_call:        UNQUOTED_VALUE "(" [value] ")"
scoped_func_call: UNQUOTED_VALUE "::" UNQUOTED_VALUE "(" [value] ")"

# =============================================================================
# MACROS
# =============================================================================

# Lark drops literal commas (",") because they are anonymous terminals
macro_def:    "macro" UNQUOTED_VALUE "(" macro_params? ")" block _NL?
macro_call:   MACRO_NAME "(" macro_args? ")"
macro_params: macro_param ("," macro_param)*
macro_param:  UNQUOTED_VALUE ("=" value)?
macro_args:   value ("," value)*

# =============================================================================
# LINQ
# =============================================================================

linq_statement.2: "for" UNQUOTED_VALUE "(" ")" block
                | "for" UNQUOTED_VALUE "(" ")" _NL* "." _NL* "which" "(" condition ")" block
                | "for" loop_binding UNQUOTED_VALUE "(" ")" block
                | "for" loop_binding UNQUOTED_VALUE "(" ")" _NL* "." _NL* "which" "(" condition ")" block

# Python-style loop head: `cty in`. Emits a SCOPE_DEF marker that binds the
# loop variable; the bare (bindingless) forms above just iterate.
loop_binding: UNQUOTED_VALUE "in"

# Array iteration: `for value, index in arr[]:` -> for_each_loop.
# Distinct from the scope loops above by the ',' after the first variable.
array_loop.2: "for" UNQUOTED_VALUE "," UNQUOTED_VALUE "in" UNQUOTED_VALUE "[]" block

# =============================================================================
# ASSIGNMENTS
# =============================================================================

assignment:    value operator value
short_assign:  value SHORT_ASSIGN value
clear_var:     value SHORT_ASSIGN NULL
math_assign:   value MATH_OPERATOR value
inc_dec: value INC_DEC_OP

# =============================================================================
# ARRAYS
# =============================================================================

array_method:    UNQUOTED_VALUE "[]." UNQUOTED_VALUE "(" [value] ")"
array_minmax:    UNQUOTED_VALUE "[]." UNQUOTED_VALUE "(" value "," value ")"
array_assign:    UNQUOTED_VALUE "[" value "]" SHORT_ASSIGN value
clear_arr:       UNQUOTED_VALUE "[]" SHORT_ASSIGN NULL
array_null_check: UNQUOTED_VALUE "[]" COMP_OPERATOR NULL
array_check:     value "in" UNQUOTED_VALUE "[]"
array_not_check: value NOT_OP "in" UNQUOTED_VALUE "[]"
array_size:      UNQUOTED_VALUE "[].size()"
array_access:    UNQUOTED_VALUE "[" value "]"

# =============================================================================
# VALUES
# =============================================================================

?value: simple_value
      | arith_expr

?simple_value: array_size
             | array_access
             | macro_call
             | PREFIXED_REF   -> prefixed_value
             | COUNTRY_TAG    -> country_tag
             | UNQUOTED_VALUE -> unquoted_value
             | string

# Inline arithmetic (no nesting): `a + b`, `x * 2`. Lifted into temp vars
# by a post-pass. Operands are simple_value, so chaining (`a + b + c`)
# is intentionally not accepted.
arith_expr: simple_value ARITH_OP simple_value

string: ESCAPED_STRING

# =============================================================================
# BLOCKS & MISC
# =============================================================================

block:         ":" comment? _NL _INDENT (_NL | item)* _DEDENT
     |         "=" "{" (_NL | item)* "}"
generic_block: UNQUOTED_VALUE ("(" ")")? block

# Raw (verbatim) block: name(): { ... }. Its lines are emitted literally,
# with no check_variable / "= yes" sugar — an escape hatch for vanilla
# trigger blocks like has_opinion. The middle token of a raw line may be an
# operator OR a bare identifier (a macro operator-placeholder).
raw_block: UNQUOTED_VALUE "(" ")" ":" "{" comment? _NL _INDENT (_NL | raw_line _NL | comment _NL)* _DEDENT "}"  -> raw_block
         | UNQUOTED_VALUE "(" ")" ":" INLINE_RAW                                                              -> raw_block_inline
raw_line:  value "=" value            -> raw_line_op
        |  value COMP_OPERATOR value   -> raw_line_op
        |  value UNQUOTED_VALUE value   -> raw_line_op
comment:       COMMENT
var_check:     value COMP_OPERATOR value
null_check:    value COMP_OPERATOR NULL
operator:      "=" | COMP_OPERATOR_VANILLA

# =============================================================================
# TERMINALS — OPERATORS
# =============================================================================

COMP_OPERATOR:         "==" | "!=" | ">" | "<" | ">=" | "<="
COMP_OPERATOR_VANILLA: ">" | "<" | ">=" | "<="
SHORT_ASSIGN.2:        "<-"
MATH_OPERATOR.2:       "+=" | "-=" | "*=" | "/="
ARITH_OP:              "+" | "-" | "*" | "/"
INC_DEC_OP.2:          "++" | "--"
# Inline raw-block body: `{ ... }` with no newline or nested braces inside.
# Priority .2 so the whole brace span is captured as one token on single-line
# raw blocks, instead of matching the literal "{" of the multi-line form.
INLINE_RAW.2:          /\{[^{}\n]*\}/
# `var:NAME` / `token:NAME` matched as ONE token (prefix glued to ':'), so a
# bare `var` / `token` used as a key or function name (var(...), var=honor_stat)
# is NOT captured and stays an ordinary identifier.
PREFIXED_REF.3:        /(var|token):[A-Za-z0-9_.@]+/
NULL:                  "null"
NOT_OP:                "not"
AND_OP:                "and"
OR_OP:                 "or"

# =============================================================================
# TERMINALS — VALUES & NAMES
# =============================================================================

# Digits with optional single underscores as separators (e.g. 1_000_000)
UNQUOTED_VALUE: /-?[0-9]+(_[0-9]+)*(\.[0-9]+(_[0-9]+)*)?/ | /[a-zA-Z0-9_\.@]+/
COUNTRY_TAG:    "$" /[A-Z0-9_]+/
MACRO_NAME.2:   "$" /[a-z][a-zA-Z0-9_]*/
COMMENT:        /#[^\n]*/

%import common.ESCAPED_STRING

# =============================================================================
# WHITESPACE & INDENTATION
# =============================================================================

# Declare indentation tokens
%declare _INDENT _DEDENT

# Newlines are significant - they consume trailing whitespace
_NL: ( /\r?\n[\t ]*/ )+

# Spaces and tabs are ignored within a line
%ignore /[\t ]+/

# Named brackets let Lark hide them from the AST,
# so transformer.py receives clean data without bracket tokens
_LPAR: "("
_RPAR: ")"
_LSQB: "["
_RSQB: "]"


