# =============================================================================
# ENTRY POINT
# =============================================================================

start: (_NL | item)*

?item: if_statement
     | elif_statement
     | else_statement
     | while_statement
     | match_statement
     | linq_statement
     | array_loop
     | range_loop
     | macro_def
     | raw_block
     | raw_stmt          _NL
     | expr_statement    _NL
     | scored_country    _NL
     | sorted_countries  _NL
     | func_call        _NL
     | scoped_func_call _NL
     | scoped_macro_call _NL
     | scoped_chain      _NL
     | scoped_block
     | rand_call         _NL
     | prefixed_scoped_call _NL
     | assignment       _NL
     | array_rand_assign _NL
     | rand_assign       _NL
     | rand_call         _NL
     | tuple_assign      _NL
     | short_assign     _NL
     | math_assign      _NL
     | inc_dec          _NL
     | array_method     _NL
     | bracket_list      _NL
     | array_minmax     _NL
     | array_assign     _NL
     | var_check        _NL
     | array_check      _NL
     | array_not_check  _NL
     | not_statement    _NL
     | pass_statement   _NL
     | break_statement  _NL
     | clear_var        _NL
     | clear_arr        _NL
     | null_check       _NL
     | array_null_check _NL
     | comment          _NL
     | generic_block
     | prefixed_block

# =============================================================================
# CONTROL FLOW
# =============================================================================

if_statement:   "if"   ( "(" condition ")" | condition ) block
elif_statement: "elif" ( "(" condition ")" | condition ) block
else_statement: "else" block

# `while cond:` -> while_loop_effect. Same shape as if_statement (condition
# becomes a limit block, body follows); only the emitted key differs.
while_statement: "while" ( "(" condition ")" | condition ) block

# `match subject:` with `case a | b:` arms -> if / else_if / else chain.
# Each case compares the subject against its patterns; multiple patterns are
# OR-ed. `case _:` is the default arm and becomes the trailing `else`.
# Pure sugar: the emitted triggers are the same check_variable / OR blocks the
# equivalent if/elif/else would produce.
match_statement: "match" value ":" comment? _NL _INDENT case_clause+ _DEDENT
case_clause: "case" case_patterns ":" comment? _NL _INDENT (_NL | item)* _DEDENT
case_patterns: value (PIPE_OP value)*

# =============================================================================
# CONDITIONS
# =============================================================================

condition:     conj_element (OR_OP conj_element)*
?conj_element: not_element (AND_OP not_element)*
?not_element:  NOT_OP cond_atom -> logical_not
            |  cond_atom
?cond_atom:    func_call
          |    scoped_func_call
          |    bracket_list
          |    var_check
          |    null_check
          |    array_check
          |    array_not_check
          |    array_null_check
          |    assignment
          |    value
          |    "(" condition ")"

# Statement-level negation: `not <trigger>` as a standalone line (e.g. inside
# a macro body). Reuses cond_atom + the logical_not handler, so it expands to
# the same NOT = { ... } block that `NOT::trigger()` produced.
not_statement: NOT_OP cond_atom -> logical_not

# Python-style no-op. Produces nothing; it exists so an indentation block
# can be syntactically non-empty (e.g. an if-branch that does nothing).
pass_statement: "pass"
break_statement: "break"

# A bare value on its own line. Its main purpose is the body of a
# value-macro (`macro f(): some_value`); an operator-macro call used as a
# statement also lands here and passes its statement list straight through.
expr_statement: value

# =============================================================================
# FUNCTIONS & CALLS
# =============================================================================

func_call:        UNQUOTED_VALUE "(" [value] ")"

# Scorer effects with fixed signatures and array-typed arguments:
#   get_highest_scored_country(scorer, var)
#   get_sorted_scored_countries(scorer, arr[] [, scores[]])
scored_country:   "get_highest_scored_country" "(" value "," value ")"
sorted_countries: "get_sorted_scored_countries" "(" value "," UNQUOTED_VALUE "[]" ("," UNQUOTED_VALUE "[]")? ")"
scoped_func_call: UNQUOTED_VALUE ARROW UNQUOTED_VALUE "(" [value] ")"

# `scope->$macro(args)` — a scope transition whose body is a macro expansion:
#   other->$add_opinion_modifier(ROOT, m)  ->  other = { <expanded body> }
scoped_macro_call: UNQUOTED_VALUE ARROW macro_call

# Multi-level scope chain A->B->...->trigger(arg) -> nested scope blocks.
# Needs >=2 arrows so it doesn't collide with single-arrow scoped_func_call.
scoped_chain: UNQUOTED_VALUE ARROW UNQUOTED_VALUE (ARROW UNQUOTED_VALUE)+ "(" [value] ")"

# `scope::func:` opening a block (vs scoped_func_call's `scope::func(arg)`).
# For engine scope-transitions that take a trigger/effect block rather than a
# single argument, e.g. THIS::any_controlled_state: -> THIS = { any_controlled_state = { ... } }
scoped_block: UNQUOTED_VALUE ARROW UNQUOTED_VALUE block

# One-line form of a prefixed scope + trigger:
#   var:NAME[i]::func(arg)  ->  var:NAME^i = { func = arg }
#   var:NAME::func(arg)     ->  var:NAME   = { func = arg }
# The '::' separator mirrors scoped_func_call; the left side is a PREFIXED_REF
# with an optional [index].
prefixed_scoped_call: PREFIXED_REF ("[" value "]")? ARROW UNQUOTED_VALUE "(" [value] ")"

# =============================================================================
# MACROS
# =============================================================================

# Lark drops literal commas (",") because they are anonymous terminals
macro_def:    "macro" UNQUOTED_VALUE "(" macro_params? ")" block _NL?
macro_call:   MACRO_NAME "(" macro_args? ")"
macro_params: macro_param ("," macro_param)*
macro_param:  UNQUOTED_VALUE (EQUAL_OP value)?
macro_args:   value ("," value)*

# =============================================================================
# LINQ
# =============================================================================

linq_statement.2: "for" UNQUOTED_VALUE "(" ")" block
                | "for" UNQUOTED_VALUE "(" ")" _NL* "." _NL* "which" "(" condition ")" block
                | "for" loop_binding UNQUOTED_VALUE "(" ")" block
                | "for" loop_binding UNQUOTED_VALUE "(" ")" _NL* "." _NL* "which" "(" condition ")" block

# Python-style loop head: `cty in`. Emits a SCOPE_DEF marker that binds the
# loop variable; the bare (bindingless) forms above just iterate.
loop_binding: UNQUOTED_VALUE "in"

# Array iteration: `for value, index in arr[]:` -> for_each_loop.
# Distinct from the scope loops above by the ',' after the first variable.
array_loop.2: "for" UNQUOTED_VALUE "," UNQUOTED_VALUE "in" UNQUOTED_VALUE "[]" block

# Numeric iteration: `for _x in range(end):` -> for_loop_effect.
# range(end) / range(start, end) / range(start, end, step). Distinct from the
# scope loops by the RANGE_KW terminal, and from array_loop by the absence of a
# ',' before "in". Priority .3 so `range(` is not taken as a bare scope call.
range_loop.3: "for" UNQUOTED_VALUE "in" RANGE_KW "(" value ("," value)~0..2 ")" block

# =============================================================================
# ASSIGNMENTS
# =============================================================================

assignment:    value operator value
short_assign:  value EQUAL_OP value

# Tuple assignment sugar: `a, b, c = 1, 2, 3` -> three separate assignments,
# each honouring its own '&' marker. Needs 2+ targets so it never collides with
# the single-target short_assign.
tuple_assign:  value ("," value)+ EQUAL_OP value ("," value)+
clear_var:     value EQUAL_OP NULL
math_assign:   value MATH_OPERATOR value
inc_dec: value INC_DEC_OP

# =============================================================================
# ARRAYS
# =============================================================================

array_method:    UNQUOTED_VALUE "[]." UNQUOTED_VALUE "(" [value] ")"
array_minmax:    UNQUOTED_VALUE "[]." UNQUOTED_VALUE "(" value "," value ")"
array_assign:    UNQUOTED_VALUE "[" value "]" EQUAL_OP value
clear_arr:       UNQUOTED_VALUE "[]" EQUAL_OP NULL
array_null_check: UNQUOTED_VALUE "[]" COMP_OPERATOR NULL
array_check:     value "in" UNQUOTED_VALUE "[]"
array_not_check: value NOT_OP "in" UNQUOTED_VALUE "[]"
array_size:      UNQUOTED_VALUE "[].size()"
array_access:    UNQUOTED_VALUE "[" value "]"

# Bracket list-trigger: `name[a, b, c]` -> `name = { a b c }`. For engine
# triggers that take a bare list block (e.g. owns_any_state_of). Requires TWO+
# elements (the `("," value)+`), so a single `name[i]` stays array_access.
bracket_list: UNQUOTED_VALUE "[" value ("," value)+ "]"

# =============================================================================
# VALUES
# =============================================================================

?value: arith_expr

# Arithmetic with C-like precedence, lowest to highest:
#   sum   : + -            (left associative)
#   term  : * / %          (left associative)
#   power : **             (right associative)
#   factor: unary, parens, math builtins, and simple_value atoms
# A single atom (no operator) collapses straight back to simple_value via the
# ?-inlined chain, so non-arithmetic values are unaffected. The whole tree is
# compiled to a nested accumulator `value = { ... }` block by a post-pass.
?arith_expr: sum

?sum:  sum ADD_OP term    -> arith_binop
    |  term

?term: term MUL_OP power  -> arith_binop
    |  power

# Right associative: `2 ** 3 ** 2` == `2 ** (3 ** 2)`.
?power: factor POW_OP power -> arith_binop
      | factor

?factor: "(" arith_expr ")"
       | math_func
       | simple_value

# Math builtins that take explicit argument lists. Kept as their own rule
# (not func_call) so multi-arg forms like clamp(x, lo, hi) are expressible and
# so they can appear as operands inside a larger expression. Dispatch by name
# happens in the transformer.
math_func: MATH_FUNC_NAME "(" arith_expr ("," arith_expr)* ")"

# Random-value builtins (statement-level effects, not value expressions):
#   rand(var)            /  var = rand()
#   randf(var, min, max) /  var = randf(min, max)   (float, max as-is)
#   randi(var, min, max) /  var = randi(min, max)   (int, max+1 -> inclusive)
# The `var = rand*(...)` form is sugar: the compiler moves the LHS into the
# first argument, so both forms produce identical output (no extra temp).
# temp vs persistent is chosen from var's '_' prefix.
rand_call: RAND_FUNC_NAME "(" (value ("," value ("," value)?)?)? ")"
rand_assign: value EQUAL_OP rand_call

# Random array access, assignment-RHS only (they produce a random value into
# the LHS variable, so they can't be bare inline values):
#   var = arr[].rand_idx()  -> random VALID index 0..size-1 into var
#   var = arr[].rand()      -> random ELEMENT of arr into var
# rand_idx uses max=arr^num with the engine's half-open [min,max), giving
# 0..size-1 exactly (no off-by-one — unlike randi(0, arr[].size()) which is
# inclusive and overruns by one).
array_rand: UNQUOTED_VALUE "[]." ARRAY_RAND_METHOD "(" ")"
array_rand_assign: value EQUAL_OP array_rand

?simple_value: array_size
             | array_access
             | macro_call
             | PREFIXED_REF   -> prefixed_value
             | COUNTRY_TAG    -> country_tag
             | UNQUOTED_VALUE -> unquoted_value
             | string

string: ESCAPED_STRING

# =============================================================================
# BLOCKS & MISC
# =============================================================================

block:         ":" comment? _NL _INDENT (_NL | item)* _DEDENT
generic_block: UNQUOTED_VALUE ("(" ")")? block

# A var:/token:/mtth: reference used as a SCOPE header, with an optional array
# index: `var:NAME[i]:` -> `var:NAME^i = { ... }`. The index `[i]` maps to the
# engine's `^i` element access; without an index it scopes the scalar ref.
prefixed_block: PREFIXED_REF ("[" value "]")? block

# Raw (verbatim) block: `raw name:` (multiline) or `raw name: { ... }` (inline).
# Its lines are emitted literally, with no check_variable / "= yes" sugar вЂ” an
# escape hatch for vanilla trigger blocks (has_opinion) and bare-token lists
# (ai_national_focuses). The middle token of a raw line may be an operator OR a
# bare identifier (a macro operator-placeholder); a lone token is emitted as-is.
raw_block: RAW_KW UNQUOTED_VALUE ":" "{" comment? _NL _INDENT (_NL | raw_line _NL | comment _NL)* _DEDENT "}"  -> raw_block
         | RAW_KW UNQUOTED_VALUE ":" INLINE_RAW                                                              -> raw_block_inline
raw_line:  value EQUAL_OP value            -> raw_line_op
        |  value COMP_OPERATOR value   -> raw_line_op
        |  value UNQUOTED_VALUE value   -> raw_line_op
        |  value                        -> raw_line_bare

# Bare raw trigger as a standalone statement: `raw LHS op RHS`, emitted verbatim
# with no sugar and NO wrapping block. Distinguished from `raw name:` (block) by
# the absence of ':'. The middle token may be a comparison operator, '=', or a
# bare identifier (a macro operator-placeholder like `_op`). This is what powers
# a reusable `compare(field, op, val)` macro whose body is `raw field op val`.
raw_stmt:  RAW_KW value EQUAL_OP value            -> raw_stmt_op
        |  RAW_KW value COMP_OPERATOR value   -> raw_stmt_op
        |  RAW_KW value UNQUOTED_VALUE value   -> raw_stmt_op
comment:       COMMENT
var_check:     value COMP_OPERATOR value
null_check:    value COMP_OPERATOR NULL
operator:      EQUAL_OP | COMP_OPERATOR_VANILLA

# =============================================================================
# TERMINALS вЂ” OPERATORS
# =============================================================================

COMP_OPERATOR:         "==" | "!=" | ">" | "<" | ">=" | "<="
COMP_OPERATOR_VANILLA: ">" | "<" | ">=" | "<="
EQUAL_OP:              "="
MATH_OPERATOR.2:       "+=" | "-=" | "*=" | "/="
# Arithmetic operators, split by precedence tier. POW_OP ("**") has higher
# priority than MUL_OP so "**" is never lexed as two "*". These feed the
# sum/term/power cascade in the VALUES section.
POW_OP.3:              "**"
MUL_OP:                "*" | "/" | "%"
ADD_OP:                "+" | "-"
# Math builtins (sqrt/round/clamp). The lookahead `(?=\s*\()` matches the name
# only when it is immediately used as a call, so a bare identifier named e.g.
# `round` elsewhere is still an ordinary UNQUOTED_VALUE. Priority .4 wins over
# UNQUOTED_VALUE when the lookahead holds.
MATH_FUNC_NAME.4:      /(sqrt|abs|round|clamp)(?=\s*\()/
RAND_FUNC_NAME.4:      /(rand|randf|randi)(?=\s*\()/
ARRAY_RAND_METHOD.5:   "rand_idx" | "rand"
# `range` only when used as a call, so a bare identifier named `range` stays an
# ordinary UNQUOTED_VALUE (same lookahead trick as MATH_FUNC_NAME).
RANGE_KW.4:            /range(?=\s*\()/
INC_DEC_OP.2:          "++" | "--"
# Scope-access operator (was `::`). High priority so `->` is one token.
ARROW.4:               "->"
# Inline raw-block body: `{ ... }` with no newline or nested braces inside.
# Priority .2 so the whole brace span is captured as one token on single-line
# raw blocks, instead of matching the literal "{" of the multi-line form.
INLINE_RAW.2:          /\{[^{}\n]*\}/
# `var:NAME` / `token:NAME` / `mtth:NAME` matched as ONE token (prefix glued to
# ':'), so a bare `var` / `token` / `mtth` used as a key or function name
# (var(...), var=honor_stat) is NOT captured and stays an ordinary identifier.
PREFIXED_REF.3:        /(var|token|mtth):[A-Za-z0-9_.@]+/
# `raw` block marker. Lookahead guards the word boundary so an identifier like
# `raw_score` or `rawdata` is NOT captured вЂ” only a standalone `raw`.
RAW_KW.3:              /raw(?![A-Za-z0-9_])/
NULL:                  "null"
NOT_OP:                "not"
AND_OP:                "and"
OR_OP:                 "or"
# Pattern separator in `case a | b:`. Distinct from OR_OP ("or"), so no clash.
PIPE_OP:               "|"

# =============================================================================
# TERMINALS вЂ” VALUES & NAMES
# =============================================================================

# Digits with optional single underscores as separators (e.g. 1_000_000)
UNQUOTED_VALUE: /-?[0-9]+(_[0-9]+)*(\.[0-9]+(_[0-9]+)*)?/ | /[a-zA-Z0-9_\.@&]+/
COUNTRY_TAG:    "$" /[A-Z0-9_]+/
MACRO_NAME.2:   "$" /[a-z][a-zA-Z0-9_]*/
COMMENT:        /#[^\n]*/

%import common.ESCAPED_STRING

# =============================================================================
# WHITESPACE & INDENTATION
# =============================================================================

# Declare indentation tokens
%declare _INDENT _DEDENT

# Newlines are significant - they consume trailing whitespace
_NL: ( /\r?\n[\t ]*/ )+

# Spaces and tabs are ignored within a line
%ignore /[\t ]+/

# Named brackets let Lark hide them from the AST,
# so transformer.py receives clean data without bracket tokens
_LPAR: "("
_RPAR: ")"
_LSQB: "["
_RSQB: "]"
